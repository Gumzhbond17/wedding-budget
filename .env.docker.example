# Settings for docker-compose.yml. Copy to .env (next to docker-compose.yml) and fill in the
# secrets. .env is git-ignored; never commit it and never bake it into an image.

# Port on the host. The whole app (SPA + API) is served on this one origin.
APP_PORT=8080

# Public URL of the app: signed receipt links and Sanctum depend on it.
# Behind HTTPS in production: https://budget.example.com
APP_URL=http://localhost:8080
# Host (and port, if not 80/443) the browser uses: Sanctum only gives session cookies to it.
SANCTUM_STATEFUL_DOMAINS=localhost:8080

APP_ENV=production
APP_DEBUG=false
# Generate once and keep it stable (it signs receipt URLs and encrypts sessions). Compose
# refuses to start without it, so create it with plain docker (any shell):
#   docker run --rm php:8.5-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# true in production (HTTPS). Only for a local http://localhost trial set it to false,
# or the browser drops the session cookie.
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120
LOG_LEVEL=warning

DB_DATABASE=wedding_budget
DB_USERNAME=wedding
# Use long random values, e.g. openssl rand -base64 32
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
